[Unit]
Description=sing-box web panel
Documentation=file:///usr/share/doc/singbox-panel/README.Debian
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/lib/singbox-panel
EnvironmentFile=-/etc/default/singbox-panel
ExecStart=/usr/bin/python3 -I /usr/lib/singbox-panel/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
